    "security"
  ],
  "dependencies": {
    "@lmstudio/sdk": "1.4.0",
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.8",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
